  document.querySelectorAll("[data-wa]").forEach(function (a) { a.href = WA; });

  // Gallery: hide broken images (placeholder shows), open lightbox for loaded ones
  var lb = document.getElementById("lightbox"), lbImg = document.getElementById("lbImg"), lbCap = document.getElementById("lbCap");
  document.querySelectorAll("#gallery .shot").forEach(function (btn) {
    var img = btn.querySelector("img");
    img.addEventListener("error", function () { img.style.display = "none"; });
    btn.addEventListener("click", function () {
      if (!img.complete || !img.naturalWidth) return;
      lbImg.src = img.currentSrc || img.src; lbImg.alt = img.alt; lbCap.textContent = btn.getAttribute("data-cap") || "";
      lb.hidden = false;
      document.getElementById("lbClose").focus();
    });
  });
  function closeLb() { lb.hidden = true; lbImg.removeAttribute("src"); }
  document.getElementById("lbClose").addEventListener("click", closeLb);
  lb.addEventListener("click", function (e) { if (e.target === lb) closeLb(); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !lb.hidden) closeLb(); });

  // Copy phone number
  var copyBtn = document.getElementById("copyNum");
  copyBtn.addEventListener("click", function () {
    var n = "686 736 41 85", done = function () { copyBtn.textContent = "Número copiado"; setTimeout(function () { copyBtn.textContent = "Copiar número"; }, 1800); };
    try {
      navigator.clipboard.writeText(n).then(done, function () { selectNum(); });

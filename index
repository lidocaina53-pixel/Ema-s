<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>EMA'S Barra & Meseros</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400;1,6..96,500&family=Hanken+Grotesk:wght@300;400;500;600&display=swap">
<meta name="description" content="EMA'S: servicio profesional de barra, bartenders y meseros para bodas, XV años y eventos empresariales. Cotiza por WhatsApp.">
<style>
body { margin: 0; }
img { max-width: 100%; }
[hidden] { display: none !important; }
/* Layout: sticky slim nav, typographic hero, hairline-ruled service list, photo gallery with lightbox, dark photography band, floating WhatsApp button */
:root {
  --bg: #F7F6F4;
  --surface: #FFFFFF;
  --fg: #1C1718;
  --muted: #655C5E;
  --line: #DDD6D3;
  --wine: #7B1E2C;
  --wine-ink: #FFFFFF;
  --brass: #96762F;
  --band: #1A1213;
  --band-fg: #F3ECE8;
  --band-muted: #B9AAA6;
  --font-display: "Bodoni Moda", "Didot", "Times New Roman", serif;
  --font-body: "Hanken Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #130E0F; --surface: #1C1516; --fg: #F1EAE6; --muted: #B3A5A1; --line: #3A2E2F;
    --wine: #C45A6A; --wine-ink: #130E0F; --brass: #C9A35A; --band: #1F1517; --band-fg: #F3ECE8; --band-muted: #B9AAA6;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #130E0F; --surface: #1C1516; --fg: #F1EAE6; --muted: #B3A5A1; --line: #3A2E2F;
  --wine: #C45A6A; --wine-ink: #130E0F; --brass: #C9A35A; --band: #1F1517; --band-fg: #F3ECE8; --band-muted: #B9AAA6;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  background: var(--bg); color: var(--fg);
  font-family: var(--font-body); font-size: 16px; line-height: 1.65;
  -webkit-font-smoothing: antialiased;
}
body::before { content: ""; position: fixed; inset: 0 0 auto; height: env(safe-area-inset-top, 0px); background: var(--bg); z-index: 60; }
h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 400; margin: 0; text-wrap: balance; line-height: 1.12; }
p { margin: 0; }
a { color: inherit; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--wine); outline-offset: 3px; }
.wrap { max-width: 1120px; margin: 0 auto; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
section { scroll-margin-top: 72px; }
.eyebrow { font-size: 0.75rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--brass); font-weight: 500; }
.sec { padding-block: clamp(3.5rem, 8vw, 6.5rem); }
.sec-head { display: grid; gap: 0.9rem; max-width: 40rem; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
.sec-head h2 { font-size: clamp(2rem, 4.6vw, 3.1rem); }
.sec-head p { color: var(--muted); max-width: 34rem; }

/* buttons */
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 46px; padding: 0 1.6rem; border-radius: 2px; font: 500 0.82rem/1 var(--font-body); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s; }
.btn-primary { background: var(--wine); color: var(--wine-ink); }
.btn-primary:hover { background: color-mix(in srgb, var(--wine) 85%, var(--fg)); }
.btn-ghost { border-color: var(--line); color: var(--fg); background: transparent; }
.btn-ghost:hover { border-color: var(--brass); color: var(--brass); }
.btn-light { background: var(--band-fg); color: var(--band); }
.btn-light:hover { background: #fff; }
.btn-outline-light { border-color: rgba(243,236,232,.35); color: var(--band-fg); background: transparent; }
.btn-outline-light:hover { border-color: var(--band-fg); }

/* nav */
.nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 50; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
.nav .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 64px; }
.brand { text-decoration: none; display: flex; flex-direction: column; line-height: 1; gap: 0.3rem; }
.brand b { font-family: var(--font-display); font-weight: 500; font-size: 1.6rem; letter-spacing: 0.08em; }
.brand span { font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--brass); }
.nav-links { display: flex; gap: 2rem; font-size: 0.85rem; }
.nav-links a { text-decoration: none; color: var(--muted); letter-spacing: 0.04em; }
.nav-links a:hover { color: var(--fg); }
.nav .btn { min-height: 40px; padding: 0 1.1rem; font-size: 0.74rem; }
@media (max-width: 760px) { .nav-links { display: none; } }

/* hero */
.hero { padding-block: clamp(3.5rem, 10vw, 7.5rem) clamp(3rem, 8vw, 6rem); border-bottom: 1px solid var(--line); }
.hero .wrap { display: grid; gap: 1.6rem; }
.hero h1 { font-size: clamp(2.6rem, 8vw, 5.6rem); letter-spacing: -0.01em; max-width: 14ch; }
.hero h1 em { font-style: italic; color: var(--wine); }
.hero p.lead { font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--muted); max-width: 36rem; }
.hero .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.6rem; }
.hero .facts { display: flex; flex-wrap: wrap; gap: 0.5rem 2rem; margin-top: 1.4rem; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

/* services */
.services { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); border-top: 1px solid var(--line); }
.service { padding: 1.9rem 1.6rem 2rem 0; border-bottom: 1px solid var(--line); display: grid; gap: 0.6rem; align-content: start; }
.service h3 { font-size: 1.5rem; }
.service p { color: var(--muted); font-size: 0.95rem; max-width: 26rem; }
.service .tag { font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--brass); }

/* why */
.why { background: var(--surface); border-block: 1px solid var(--line); }
.why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 2.2rem 2.4rem; }
.why-item { display: grid; gap: 0.5rem; align-content: start; }
.why-item::before { content: ""; width: 28px; height: 1px; background: var(--brass); margin-bottom: 0.5rem; }
.why-item h4 { font-family: var(--font-body); font-weight: 600; font-size: 1rem; letter-spacing: 0.01em; }
.why-item p { color: var(--muted); font-size: 0.92rem; }

/* gallery */
.gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
.shot { position: relative; margin: 0; aspect-ratio: 4 / 5; background: var(--surface); border: 1px solid var(--line); overflow: hidden; cursor: zoom-in; padding: 0; text-align: left; font: inherit; color: inherit; display: block; width: 100%; }
.shot:nth-child(1), .shot:nth-child(4) { aspect-ratio: 4 / 5; }
.shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
.shot:hover img { transform: scale(1.04); }
.shot .ph { position: absolute; inset: 0; display: grid; place-items: center; font-family: var(--font-display); font-style: italic; font-size: 2.4rem; color: var(--line); }
.shot figcaption, .shot .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.2rem 1rem 0.9rem; font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: #fff; background: linear-gradient(to top, rgba(20,12,13,.78), transparent); }
@media (max-width: 760px) { .gallery { grid-template-columns: repeat(2, 1fr); gap: 10px; } }
@media (max-width: 380px) { .gallery { grid-template-columns: 1fr; } }
.lightbox { position: fixed; inset: 0; z-index: 100; background: rgba(12,8,9,.94); display: grid; place-items: center; padding: max(16px, env(safe-area-inset-top, 0px)) max(16px, env(safe-area-inset-right, 0px)) max(16px, env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px)); }
.lightbox img { max-width: 100%; max-height: 78vh; object-fit: contain; }
.lightbox p { color: #E9DEDA; text-align: center; margin-top: 0.8rem; font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; }
.lightbox .close { position: absolute; top: calc(10px + env(safe-area-inset-top, 0px)); right: calc(14px + env(safe-area-inset-right, 0px)); width: 44px; height: 44px; border: 1px solid rgba(255,255,255,.35); background: transparent; color: #fff; font-size: 1.6rem; line-height: 1; border-radius: 50%; cursor: pointer; }

/* process */
.steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr)); gap: 2rem; counter-reset: step; }
.step { display: grid; gap: 0.6rem; align-content: start; padding-top: 1.2rem; border-top: 1px solid var(--fg); }
.step .n { font-family: var(--font-display); font-style: italic; font-size: 2.4rem; color: var(--wine); line-height: 1; }
.step h4 { font-family: var(--font-body); font-weight: 600; font-size: 1.02rem; }
.step p { color: var(--muted); font-size: 0.93rem; }

/* testimonials */
.quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1.4rem; }
.quote { background: var(--surface); border: 1px solid var(--line); padding: 2rem 1.8rem; display: grid; gap: 1.2rem; align-content: space-between; }
.stars { color: var(--brass); letter-spacing: 0.25em; font-size: 0.9rem; }
.quote blockquote { margin: 0; font-family: var(--font-display); font-size: 1.18rem; line-height: 1.5; }
.quote .who { font-size: 0.85rem; color: var(--muted); display: flex; flex-direction: column; }
.quote .who b { color: var(--fg); font-weight: 600; letter-spacing: 0.02em; }

/* photography */
.photo { background: var(--band); color: var(--band-fg); }
.photo .wrap { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: center; }
@media (max-width: 820px) { .photo .wrap { grid-template-columns: 1fr; } }
.photo h2 { font-size: clamp(2rem, 4.6vw, 3.2rem); margin: 0.9rem 0 1rem; }
.photo h2 em { font-style: italic; color: #D9B26A; }
.photo .eyebrow { color: #D9B26A; }
.photo p.lead { color: var(--band-muted); max-width: 30rem; }
.contact-card { border: 1px solid rgba(243,236,232,.22); padding: clamp(1.5rem, 4vw, 2.4rem); display: grid; gap: 1.1rem; }
.contact-card .label { font-size: 0.7rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--band-muted); }
.contact-card .name { font-family: var(--font-display); font-size: 1.9rem; line-height: 1.1; }
.contact-card .num { font-size: clamp(1.5rem, 5vw, 2rem); font-weight: 300; letter-spacing: 0.06em; font-variant-numeric: tabular-nums; user-select: all; }
.contact-card .num small { font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--band-muted); font-weight: 400; margin-left: 0.5rem; }
.contact-card .row { display: flex; flex-wrap: wrap; gap: 0.7rem; }

/* cta */
.cta { text-align: center; }
.cta .wrap { display: grid; gap: 1.5rem; justify-items: center; }
.cta h2 { font-size: clamp(2.1rem, 5.4vw, 3.6rem); max-width: 18ch; }

/* footer */
footer { border-top: 1px solid var(--line); padding-block: 2.4rem 3.6rem; }
footer .wrap { display: grid; gap: 1.4rem; }
.foot-top { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.4rem; align-items: flex-start; }
.foot-top p { color: var(--muted); font-size: 0.9rem; margin-top: 0.7rem; }
.foot-links { display: flex; flex-wrap: wrap; gap: 0.6rem 1.6rem; font-size: 0.85rem; }
.foot-links a { text-decoration: none; color: var(--muted); }
.foot-links a:hover { color: var(--wine); }
.copy { font-size: 0.78rem; color: var(--muted); padding-top: 1.2rem; border-top: 1px solid var(--line); }

/* floating whatsapp */
.fab { position: fixed; z-index: 55; right: calc(16px + env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); display: inline-flex; align-items: center; gap: 0.55rem; min-height: 50px; padding: 0 1.15rem; border-radius: 999px; background: var(--wine); color: var(--wine-ink); text-decoration: none; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; box-shadow: 0 8px 24px rgba(0,0,0,.25); }
.fab svg { width: 20px; height: 20px; fill: currentColor; flex: none; }
@media (max-width: 420px) { .fab span { display: none; } .fab { padding: 0; width: 52px; justify-content: center; } }

@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .shot img, .btn { transition: none; } }
</style>
</head>
<body>


<header class="nav">
  <div class="wrap">
    <a class="brand" href="#inicio" aria-label="EMA'S Barra y Meseros"><b>EMA'S</b><span>Barra &amp; Meseros</span></a>
    <nav class="nav-links" aria-label="Principal">
      <a href="#servicios">Servicios</a>
      <a href="#galeria">Galería</a>
      <a href="#fotografia">Fotografía</a>
      <a href="#testimonios">Testimonios</a>
    </nav>
    <a class="btn btn-primary" data-wa href="#" target="_blank" rel="noopener">Cotizar</a>
  </div>
</header>

<main id="inicio">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Servicio de Barra &amp; Meseros</p>
      <h1>Elegancia y <em>excelencia</em> para tu evento</h1>
      <p class="lead">Servicio profesional de barra, bartenders y meseros para bodas, XV años, eventos empresariales y toda celebración que merezca ser inolvidable.</p>
      <div class="actions">
        <a class="btn btn-primary" data-wa href="#" target="_blank" rel="noopener">Cotizar por WhatsApp</a>
        <a class="btn btn-ghost" href="#servicios">Ver servicios</a>
      </div>
      <div class="facts"><span>Bodas</span><span>XV Años</span><span>Eventos empresariales</span><span>Mexicali</span></div>
    </div>
  </section>

  <section id="servicios" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Lo que ofrecemos</p>
        <h2>Servicios a la medida de tu evento</h2>
        <p>Cada detalle, pensado para que tú disfrutes mientras nosotros nos encargamos del resto.</p>
      </div>
      <div class="services">
        <article class="service"><span class="tag">Barra</span><h3>Barra Libre</h3><p>Paquetes de barra libre con marcas de calidad, adaptados a tu presupuesto y estilo de evento.</p></article>
        <article class="service"><span class="tag">Coctelería</span><h3>Bartenders</h3><p>Mixólogos capacitados que preparan tus bebidas favoritas con técnica y presentación impecable.</p></article>
        <article class="service"><span class="tag">Mesa</span><h3>Meseros</h3><p>Personal atento y elegante que garantiza un servicio de mesa fluido durante toda la velada.</p></article>
        <article class="service"><span class="tag">Celebraciones</span><h3>Eventos Sociales</h3><p>Cumpleaños, aniversarios y reuniones que merecen una barra a la altura de la ocasión.</p></article>
        <article class="service"><span class="tag">Matrimonio</span><h3>Bodas</h3><p>El acompañamiento perfecto para el día más importante: elegancia, discreción y calidez.</p></article>
        <article class="service"><span class="tag">Quinceañeras</span><h3>XV Años</h3><p>Bebidas y servicio pensados para que la quinceañera y sus invitados vivan una noche inolvidable.</p></article>
        <article class="service"><span class="tag">Corporativo</span><h3>Eventos Empresariales</h3><p>Coctelería y servicio corporativo con la formalidad y profesionalismo que tu marca representa.</p></article>
      </div>
    </div>
  </section>

  <section class="sec why" id="nosotros">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Nuestro compromiso</p>
        <h2>¿Por qué elegirnos?</h2>
      </div>
      <div class="why-grid">
        <div class="why-item"><h4>Personal capacitado</h4><p>Bartenders y meseros con experiencia comprobable en eventos.</p></div>
        <div class="why-item"><h4>Excelente presentación</h4><p>Uniformes elegantes y cuidado en cada detalle visual.</p></div>
        <div class="why-item"><h4>Puntualidad</h4><p>Llegamos con tiempo para preparar cada detalle antes de tu evento.</p></div>
        <div class="why-item"><h4>Atención profesional</h4><p>Trato cordial y discreto hacia ti y todos tus invitados.</p></div>
        <div class="why-item"><h4>Servicio personalizado</h4><p>Adaptamos cada paquete a las necesidades reales de tu evento.</p></div>
        <div class="why-item"><h4>Material de calidad</h4><p>Cristalería, herramientas de barra e insumos de primer nivel.</p></div>
        <div class="why-item"><h4>Elegancia</h4><p>Un estilo cuidado en cada gesto, del montaje al último brindis.</p></div>
        <div class="why-item"><h4>Experiencia</h4><p>Años acompañando bodas, XV años y eventos empresariales en la región.</p></div>
      </div>
    </div>
  </section>

  <section id="galeria" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Momentos EMA'S</p>
        <h2>Galería</h2>
        <p>Un vistazo a nuestro equipo trabajando en eventos reales.</p>
      </div>
      <div class="gallery" id="gallery">
        <button class="shot" type="button" data-cap="Servicio de barra"><span class="ph">EMA'S</span><img src="images/9e56d90b-f9ab-4115-9c6c-e165c7136449.jpg" alt="Equipo de bartenders de EMA'S preparando la barra en un evento" loading="lazy"><span class="cap">Servicio de barra</span></button>
        <button class="shot" type="button" data-cap="Nuestro equipo"><span class="ph">EMA'S</span><img src="images/db137642-e673-43c0-80fe-983e80b2eb29.jpg" alt="Meseras de EMA'S sonriendo durante un evento social" loading="lazy"><span class="cap">Nuestro equipo</span></button>
        <button class="shot" type="button" data-cap="Uniformes elegantes"><span class="ph">EMA'S</span><img src="images/bcd1786a-17b5-4595-bc7b-0941f14d90d0.jpg" alt="Meseros de EMA'S uniformados listos para el servicio" loading="lazy"><span class="cap">Uniformes elegantes</span></button>
        <button class="shot" type="button" data-cap="Equipo EMA'S"><span class="ph">EMA'S</span><img src="images/82ea04f4-6818-4fb1-a960-92c12e9f0017.jpg" alt="Equipo completo de EMA'S en un salón de eventos" loading="lazy"><span class="cap">Equipo EMA'S</span></button>
        <button class="shot" type="button" data-cap="Presentación impecable"><span class="ph">EMA'S</span><img src="images/b0bd835f-44a3-4a34-ab95-1fc087f35eb9.jpg" alt="Meseros de EMA'S con corbata roja en un evento" loading="lazy"><span class="cap">Presentación impecable</span></button>
        <button class="shot" type="button" data-cap="Atención profesional"><span class="ph">EMA'S</span><img src="images/8958fa35-81f3-4e2f-a915-4fe669457c9d.jpg" alt="Mesera de EMA'S con uniforme profesional" loading="lazy"><span class="cap">Atención profesional</span></button>
      </div>
    </div>
  </section>

  <section class="sec" style="background: var(--surface); border-block: 1px solid var(--line);" id="proceso">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Proceso simple</p>
        <h2>Cómo trabajamos</h2>
      </div>
      <div class="steps">
        <div class="step"><span class="n">1</span><h4>Solicita información</h4><p>Escríbenos por WhatsApp contándonos sobre tu evento.</p></div>
        <div class="step"><span class="n">2</span><h4>Recibe tu cotización</h4><p>Te armamos una propuesta a la medida de tu presupuesto.</p></div>
        <div class="step"><span class="n">3</span><h4>Reserva tu fecha</h4><p>Confirmamos disponibilidad y apartamos tu evento.</p></div>
        <div class="step"><span class="n">4</span><h4>Disfruta tu evento</h4><p>Nosotros nos encargamos de la barra, tú disfrutas la fiesta.</p></div>
      </div>
    </div>
  </section>

  <section id="testimonios" class="sec">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Lo que dicen de nosotros</p>
        <h2>Testimonios</h2>
      </div>
      <div class="quotes">
        <figure class="quote" style="margin:0"><div class="stars" aria-label="5 estrellas">★★★★★</div><blockquote>El servicio de barra fue impecable, los bartenders muy atentos y todos nuestros invitados quedaron encantados con la atención.</blockquote><figcaption class="who"><b>Daniela R.</b>Boda</figcaption></figure>
        <figure class="quote" style="margin:0"><div class="stars" aria-label="5 estrellas">★★★★★</div><blockquote>Contratamos el paquete de barra libre para los XV años de mi hija y superaron nuestras expectativas en presentación y sabor.</blockquote><figcaption class="who"><b>Miguel A.</b>XV Años</figcaption></figure>
        <figure class="quote" style="margin:0"><div class="stars" aria-label="5 estrellas">★★★★★</div><blockquote>Puntuales, profesionales y con una presentación excelente. Los recomendamos ampliamente para eventos empresariales.</blockquote><figcaption class="who"><b>Laura V.</b>Evento Empresarial</figcaption></figure>
      </div>
    </div>
  </section>

  <section id="fotografia" class="sec photo">
    <div class="wrap">
      <div>
